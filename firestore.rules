rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function validGroupId(groupId) {
      return groupId is string && groupId.matches('[A-Za-z0-9_-]{6,80}');
    }

    function hasGroupField(groupId) {
      return request.resource.data.groupId == groupId;
    }

    function hasAuthUidField() {
      return request.resource.data.keys().hasAny(['authUid'])
        && request.resource.data.authUid != null
        && request.resource.data.authUid != '';
    }

    function authUidMatchesSignedInUser() {
      return !hasAuthUidField()
        || (request.auth != null && request.resource.data.authUid == request.auth.uid);
    }

    function authUidIsPreserved() {
      return !hasAuthUidField()
        || (resource.data.keys().hasAny(['authUid'])
          && resource.data.authUid == request.resource.data.authUid)
        || (request.auth != null && request.resource.data.authUid == request.auth.uid);
    }

    // Collection-group login lookups. The app queries `members` by phone
    // (findMembershipsByPhone) and `teams` by memberIds (findTeamMembershipsByPhone)
    // across ALL families. In a collection-group query the parent {groupId} is
    // unbound, so the per-family rules below — which call validGroupId(groupId) —
    // evaluate it as null and DENY the read (this was the earlier permission-denied).
    // Grant read for these two collection groups to any signed-in caller. This is
    // additive (OR'd with the rules below); writes stay governed by the strict
    // per-family rules.
    match /{path=**}/members/{memberId} {
      allow read: if request.auth != null;
    }
    match /{path=**}/teams/{teamId} {
      allow read: if request.auth != null;
    }

    // Beta-safe diagnostics: clients can write small events, but nobody can read
    // all diagnostic data from the client.
    match /diagnostics/{docId} {
      allow create: if request.resource.data.keys().hasOnly([
        'event', 'groupId', 'userId', 'appVersion', 'createdAt'
      ]);
      allow read, update, delete: if false;
    }

    // New invite flow: lookup an invite code directly instead of scanning families.
    match /inviteCodes/{code} {
      allow get: if code.matches('[0-9]{6}') || code.matches('[A-Z0-9]{6,12}');
      allow list: if false;
      allow create, update: if (code.matches('[0-9]{6}') || code.matches('[A-Z0-9]{6,12}'))
        && request.resource.data.inviteCode == code
        && request.resource.data.groupId is string;
      allow delete: if false;
    }

    // Family-name uniqueness lock. A signed-in user reserves a name when
    // creating a family; names are permanent (no update/delete).
    match /familyNames/{nameKey} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.groupId is string;
      allow update, delete: if false;
    }

    match /families/{groupId} {
      allow get: if validGroupId(groupId);
      // Temporary compatibility for old 6-digit invites. New invites use
      // inviteCodes/{code}, so remove this after all testers update.
      allow list: if request.query.limit <= 1;
      allow create, update: if validGroupId(groupId)
        && request.resource.data.id == groupId
        && request.resource.data.inviteCode is string
        && request.resource.data.adminId is string;
      allow delete: if false;

      match /members/{memberId} {
        allow read: if validGroupId(groupId);
        allow create: if validGroupId(groupId)
          && request.resource.data.id == memberId
          && authUidMatchesSignedInUser();
        allow update: if validGroupId(groupId)
          && request.resource.data.id == memberId
          && authUidIsPreserved();
        allow delete: if validGroupId(groupId);
      }

      match /messages/{messageId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && hasGroupField(groupId)
          && request.resource.data.id == messageId
          && request.resource.data.senderId is string
          && request.resource.data.content is string;
        allow delete: if validGroupId(groupId);
      }

      match /transactions/{transactionId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && hasGroupField(groupId)
          && request.resource.data.id == transactionId
          && request.resource.data.amount is number
          && request.resource.data.amount > 0;
        allow delete: if validGroupId(groupId);
      }

      match /budgets/{budgetId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && request.resource.data.category is string
          && request.resource.data.limit is number
          && request.resource.data.limit >= 0;
        allow delete: if validGroupId(groupId);
      }

      match /categories/{categoryId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && request.resource.data.name is string;
        allow delete: if validGroupId(groupId);
      }

      // Offline learning: user-taught keyword → category corrections.
      match /learnedKeywords/{kwId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && request.resource.data.category is string;
        allow delete: if validGroupId(groupId);
      }

      match /wallets/{walletId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && request.resource.data.id == walletId
          && request.resource.data.name is string
          && request.resource.data.balance is number
          && request.resource.data.balance >= 0
          && request.resource.data.isDefault is bool;
        allow delete: if validGroupId(groupId);

        // Per-wallet ledger (DR/CR movements with accumulated balance).
        match /entries/{entryId} {
          allow read: if validGroupId(groupId);
          allow create, update: if validGroupId(groupId)
            && request.resource.data.amount is number
            && request.resource.data.direction is string
            && request.resource.data.balanceAfter is number;
          allow delete: if validGroupId(groupId);
        }
      }

      match /teams/{teamId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && hasGroupField(groupId)
          && request.resource.data.id == teamId
          && request.resource.data.name is string
          && request.resource.data.ownerId is string
          && request.resource.data.memberIds is list
          && (
            (request.resource.data.balance is number
              && request.resource.data.balance >= 0)
            || (request.resource.data.limit is number
              && request.resource.data.limit >= 0)
          );
        allow delete: if validGroupId(groupId);
      }

      match /notifications/{notificationId} {
        allow read: if validGroupId(groupId);
        allow create, update: if validGroupId(groupId)
          && hasGroupField(groupId)
          && request.resource.data.id == notificationId;
        allow delete: if validGroupId(groupId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
